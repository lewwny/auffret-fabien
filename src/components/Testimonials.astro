---
// Section Avis clients : témoignages issus des avis Google.
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { company, testimonials } from '../data/site';
---

<section id="avis" class="bg-night-950 relative isolate overflow-hidden py-20 sm:py-28">
  <div
    class="bg-volt-500/10 absolute -bottom-24 left-1/2 h-72 w-72 -translate-x-1/2 rounded-full blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <SectionHeading
      label={testimonials.label}
      title={testimonials.title}
      subtitle={testimonials.subtitle}
      dark
    />

    <ul class="mt-14 grid gap-6 md:grid-cols-3">
      {
        testimonials.reviews.map((review) => (
          <li class="reveal bg-night-900 flex flex-col rounded-2xl border border-white/10 p-6">
            <div class="flex gap-1" aria-label={`Note : ${review.rating} sur 5`}>
              {Array.from({ length: review.rating }).map(() => (
                <Icon name="star" class="text-volt-400 h-5 w-5" filled />
              ))}
            </div>
            <blockquote class="text-night-100 mt-4 grow">
              <p class="leading-relaxed">“{review.text}”</p>
            </blockquote>
            <figcaption class="mt-5 flex items-center gap-3 border-t border-white/10 pt-5">
              <span class="bg-volt-400 text-night-950 flex h-11 w-11 items-center justify-center rounded-full text-sm font-bold">
                {review.initials}
              </span>
              <span>
                <span class="block text-sm font-bold text-white">{review.name}</span>
                <span class="text-night-400 block text-xs">Avis Google vérifié</span>
              </span>
            </figcaption>
          </li>
        ))
      }
    </ul>

    <p class="text-night-300 mt-10 text-center text-sm">
      <span class="text-volt-300 font-bold">{company.rating.value} / 5</span>
      sur la base de {company.rating.count} avis Google.
    </p>
  </div>
</section>
