---
// Section Contact : formulaire prêt à brancher, coordonnées,
// horaires et carte Google Maps intégrée.
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { company, contact, openingHours } from '../data/site';

const f = contact.form;
const fullAddress = `${company.address.street}, ${company.address.postalCode} ${company.address.locality}`;
---

<section id="contact" class="bg-night-50 py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <SectionHeading label={contact.label} title={contact.title} subtitle={contact.subtitle} />

    <div class="mt-14 grid gap-8 lg:grid-cols-2">
      <!-- Formulaire de contact -->
      <div class="border-night-100 rounded-2xl border bg-white p-6 shadow-sm sm:p-8">
        {
          /*
          Formulaire prêt à être branché.
          Pour le rendre fonctionnel, renseignez l'attribut `action` avec
          un service de traitement de formulaire (Formspree, Netlify Forms,
          Web3Forms…) puis adaptez la méthode si besoin.
        */
        }
        <form action="#" method="post" class="flex flex-col gap-5">
          <div>
            <label for="name" class="text-night-800 mb-1.5 block text-sm font-semibold">
              Nom complet
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              autocomplete="name"
              placeholder={f.name}
              class="border-night-200 text-night-900 placeholder:text-night-400 focus:border-volt-400 w-full rounded-lg border bg-white px-4 py-3 transition-colors"
            />
          </div>
          <div>
            <label for="phone" class="text-night-800 mb-1.5 block text-sm font-semibold">
              Téléphone
            </label>
            <input
              type="tel"
              id="phone"
              name="phone"
              required
              autocomplete="tel"
              placeholder={f.phone}
              class="border-night-200 text-night-900 placeholder:text-night-400 focus:border-volt-400 w-full rounded-lg border bg-white px-4 py-3 transition-colors"
            />
          </div>
          <div>
            <label for="message" class="text-night-800 mb-1.5 block text-sm font-semibold">
              Votre projet
            </label>
            <textarea
              id="message"
              name="message"
              rows="4"
              required
              placeholder={f.message}
              class="border-night-200 text-night-900 placeholder:text-night-400 focus:border-volt-400 w-full resize-y rounded-lg border bg-white px-4 py-3 transition-colors"
            ></textarea>
          </div>
          <button
            type="submit"
            class="bg-volt-400 text-night-950 hover:bg-volt-300 inline-flex items-center justify-center gap-2 rounded-xl px-6 py-3.5 text-base font-bold shadow-sm transition-all hover:shadow-md"
          >
            {f.submit}
            <Icon name="arrow" class="h-5 w-5" />
          </button>
          <p class="text-night-400 text-center text-xs">
            Réponse sous 24h — devis gratuit et sans engagement.
          </p>
        </form>
      </div>

      <!-- Coordonnées + carte -->
      <div class="flex flex-col gap-6">
        <ul class="grid gap-4 sm:grid-cols-2">
          <li class="border-night-100 flex items-start gap-3 rounded-2xl border bg-white p-5">
            <span
              class="bg-volt-400/15 text-volt-600 flex h-10 w-10 shrink-0 items-center justify-center rounded-lg"
            >
              <Icon name="phone" class="h-5 w-5" />
            </span>
            <div>
              <p class="text-night-400 text-xs font-semibold tracking-wide uppercase">Téléphone</p>
              <a
                href={company.phoneLink}
                class="text-night-900 hover:text-volt-600 text-sm font-bold"
              >
                {company.phoneDisplay}
              </a>
            </div>
          </li>
          <li class="border-night-100 flex items-start gap-3 rounded-2xl border bg-white p-5">
            <span
              class="bg-volt-400/15 text-volt-600 flex h-10 w-10 shrink-0 items-center justify-center rounded-lg"
            >
              <Icon name="clock" class="h-5 w-5" />
            </span>
            <div>
              <p class="text-night-400 text-xs font-semibold tracking-wide uppercase">Horaires</p>
              <p class="text-night-700 text-sm font-medium">{openingHours.display}</p>
              <p class="text-night-500 text-sm">{openingHours.closed}</p>
            </div>
          </li>
          <li
            class="border-night-100 flex items-start gap-3 rounded-2xl border bg-white p-5 sm:col-span-2"
          >
            <span
              class="bg-volt-400/15 text-volt-600 flex h-10 w-10 shrink-0 items-center justify-center rounded-lg"
            >
              <Icon name="pin" class="h-5 w-5" />
            </span>
            <div>
              <p class="text-night-400 text-xs font-semibold tracking-wide uppercase">Adresse</p>
              <p class="text-night-700 text-sm font-medium">{fullAddress}</p>
            </div>
          </li>
        </ul>

        <!-- Carte Google Maps (chargement différé) -->
        <div class="border-night-100 overflow-hidden rounded-2xl border shadow-sm">
          <iframe
            src={company.maps.embed}
            title={`Localisation de ${company.fullName} à ${company.address.locality}`}
            width="100%"
            height="300"
            style="border:0;display:block;"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
      </div>
    </div>
  </div>
</section>
