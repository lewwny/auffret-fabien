---
// Section Contact : formulaire éditorial (labels monospace) avec
// animation de confirmation à l'envoi. Aside : cartes coordonnées + carte.
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { company, contact, openingHours } from '../data/site';

const f = contact.form;
const shortAddress = `${company.address.street}, ${company.address.postalCode} ${company.address.locality}`;
---

<section class="section" id="contact">
  <div class="wrap">
    <SectionHeading
      index={contact.index}
      label={contact.label}
      title={contact.title}
      emphasisLine={contact.emphasisLine}
      lead={contact.lead}
    />

    <div class="contact-grid">
      <!-- Formulaire devis -->
      <div class="devis-wrap reveal">
        {
          /*
          Formulaire prêt à brancher : renseignez `action` avec un service
          (Formspree, Netlify Forms…). Le script en bas du fichier intercepte
          l'envoi pour jouer l'animation de confirmation.
        */
        }
        <form class="devis" data-contact-form novalidate>
          <div class="form-head">
            <span class="step"><strong>01</strong> / 02 — {f.step}</span>
            <span class="tag">RÉF. {company.ref}</span>
          </div>

          <div class="field">
            <label for="f-nom">Nom complet</label>
            <input
              id="f-nom"
              name="name"
              type="text"
              placeholder={f.fields.name}
              required
              autocomplete="name"
            />
          </div>
          <div class="field">
            <label for="f-tel">Téléphone</label>
            <input
              id="f-tel"
              name="phone"
              type="tel"
              placeholder={f.fields.phone}
              required
              autocomplete="tel"
            />
          </div>
          <div class="field">
            <label for="f-msg">Décrivez votre projet</label>
            <textarea id="f-msg" name="message" placeholder={f.fields.message} required></textarea>
          </div>

          <div class="submit-row">
            <button type="submit" class="btn btn-primary" data-submit-btn>
              <span data-btn-label class="inline-row">
                {f.submit}
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                >
                  <path d="M5 12h14M12 5l7 7-7 7"></path>
                </svg>
              </span>
              <span class="spinner" data-btn-spinner aria-hidden="true"></span>
            </button>
            <span class="tag">Réponse · sous 24 h</span>
          </div>
        </form>

        <!-- Écran de confirmation animé -->
        <div class="success" data-success role="status" aria-live="polite" hidden>
          <span class="success-badge">
            <svg
              class="checkmark"
              viewBox="0 0 52 52"
              fill="none"
              stroke="currentColor"
              stroke-width="5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path class="checkmark-check" d="M14 27l8 8 17-17"></path>
            </svg>
          </span>
          <h3 class="success-text">Demande envoyée.</h3>
          <p class="success-text">
            Merci pour votre message. Je vous recontacte sous 24 h pour votre devis gratuit.
          </p>
          <button type="button" class="btn btn-ghost success-text" data-reset>
            Envoyer une autre demande
          </button>
        </div>
      </div>

      <!-- Aside : coordonnées + carte -->
      <aside class="contact-aside reveal">
        <a class="contact-card" href={company.phoneLink}>
          <span class="ico"><Icon name="phone" class="card-icon" /></span>
          <div>
            <div class="lbl">Téléphone</div>
            <div class="val">{company.phoneDisplay}</div>
            <div class="sub">Appel direct · {openingHours.short}</div>
          </div>
          <span class="arrow" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="m7 17 10-10M17 7H8m9 0v9"></path>
            </svg>
          </span>
        </a>
        <a class="contact-card" href={company.emailLink}>
          <span class="ico"><Icon name="mail" class="card-icon" /></span>
          <div>
            <div class="lbl">E-mail</div>
            <div class="val">{company.email}</div>
            <div class="sub">Réponse sous 24 h</div>
          </div>
          <span class="arrow" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="m7 17 10-10M17 7H8m9 0v9"></path>
            </svg>
          </span>
        </a>
        <div class="contact-card">
          <span class="ico"><Icon name="pin" class="card-icon" /></span>
          <div>
            <div class="lbl">Adresse</div>
            <div class="val">{shortAddress}</div>
            <div class="sub">{company.address.region} · France · rayon {company.radiusKm} km</div>
          </div>
          <span class="arrow"></span>
        </div>
        <div class="contact-card">
          <span class="ico"><Icon name="clock" class="card-icon" /></span>
          <div>
            <div class="lbl">Horaires</div>
            <div class="val">{openingHours.display}</div>
            <div class="sub">{openingHours.closed}</div>
          </div>
          <span class="arrow"></span>
        </div>
        <div class="map-frame">
          <iframe
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            src={company.maps.embed}
            title={`Carte — ${company.address.locality}`}></iframe>
        </div>
      </aside>
    </div>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const success = document.querySelector<HTMLElement>('[data-success]');
  const submitBtn = document.querySelector<HTMLButtonElement>('[data-submit-btn]');
  const btnLabel = document.querySelector<HTMLElement>('[data-btn-label]');
  const btnSpinner = document.querySelector<HTMLElement>('[data-btn-spinner]');
  const resetBtn = document.querySelector<HTMLButtonElement>('[data-reset]');

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    if (submitBtn) submitBtn.disabled = true;
    btnLabel?.classList.add('is-hidden');
    btnSpinner?.classList.add('is-visible');

    window.setTimeout(() => {
      form.classList.add('is-hidden');
      success?.removeAttribute('hidden');
    }, 750);
  });

  resetBtn?.addEventListener('click', () => {
    form?.classList.remove('is-hidden');
    success?.setAttribute('hidden', '');
    form?.reset();
    if (submitBtn) submitBtn.disabled = false;
    btnLabel?.classList.remove('is-hidden');
    btnSpinner?.classList.remove('is-visible');
  });
</script>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 56px;
    align-items: start;
  }
  @media (max-width: 980px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }

  .devis-wrap {
    position: relative;
  }

  /* ── Formulaire ────────────────────────────────────────── */
  .devis {
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: 14px;
    padding: 28px 28px 24px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .devis.is-hidden {
    display: none;
  }
  .form-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--color-line);
    gap: 12px;
    flex-wrap: wrap;
  }
  .form-head .step {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    color: var(--color-mute);
    text-transform: uppercase;
  }
  .form-head .step strong {
    color: var(--color-ink);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .field label {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-mute);
  }
  .field input,
  .field textarea {
    background: var(--color-canvas);
    border: 1px solid var(--color-line);
    border-radius: 10px;
    padding: 13px 14px;
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-size: 16px;
    outline: none;
    transition:
      border-color 0.2s,
      background 0.2s;
  }
  .field input::placeholder,
  .field textarea::placeholder {
    color: color-mix(in oklab, var(--color-ink) 35%, transparent);
  }
  .field input:focus,
  .field textarea:focus {
    border-color: var(--color-electric);
    background: var(--color-paper);
  }
  .field textarea {
    resize: vertical;
    min-height: 110px;
  }
  .submit-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    padding-top: 6px;
  }
  .inline-row {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .is-hidden {
    display: none;
  }
  .spinner {
    display: none;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 2px solid color-mix(in oklab, var(--color-ink) 30%, transparent);
    border-top-color: var(--color-ink);
    animation: spin 0.7s linear infinite;
  }
  .spinner.is-visible {
    display: inline-block;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* ── Confirmation animée ───────────────────────────────── */
  .success {
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: 14px;
    padding: 56px 28px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }
  .success[hidden] {
    display: none;
  }
  .success-badge {
    display: grid;
    place-items: center;
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: var(--color-ink);
    color: var(--color-electric-hi);
    animation: pop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }
  .checkmark {
    width: 44px;
    height: 44px;
  }
  .checkmark-check {
    stroke-dasharray: 48;
    stroke-dashoffset: 48;
    animation: draw 0.45s 0.35s ease-out forwards;
  }
  .success h3 {
    font-size: 26px;
    letter-spacing: -0.025em;
    font-weight: 500;
    margin: 0;
  }
  .success p {
    color: var(--color-ink-2);
    font-size: 15px;
    line-height: 1.5;
    max-width: 38ch;
    margin: 0;
  }
  .success-text {
    opacity: 0;
    animation: fade-up 0.5s 0.5s ease-out forwards;
  }
  @keyframes pop {
    0% {
      transform: scale(0);
      opacity: 0;
    }
    100% {
      transform: scale(1);
      opacity: 1;
    }
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .success-badge,
    .checkmark-check,
    .success-text {
      animation: none;
    }
    .checkmark-check {
      stroke-dashoffset: 0;
    }
    .success-text {
      opacity: 1;
    }
  }

  /* ── Aside : coordonnées + carte ───────────────────────── */
  .contact-aside {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .contact-card {
    border: 1px solid var(--color-line);
    border-radius: 14px;
    background: var(--color-paper);
    padding: 20px 22px;
    display: grid;
    grid-template-columns: 38px 1fr auto;
    gap: 16px;
    align-items: center;
    color: inherit;
    text-decoration: none;
    transition: border-color 0.25s;
  }
  .contact-card:hover {
    border-color: var(--color-electric);
  }
  .contact-card .ico {
    width: 38px;
    height: 38px;
    border-radius: 12px;
    background: var(--color-electric-soft);
    color: var(--color-ink);
    display: grid;
    place-items: center;
  }
  .contact-card :global(.card-icon) {
    width: 16px;
    height: 16px;
  }
  .contact-card .lbl {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-mute);
    margin-bottom: 4px;
  }
  .contact-card .val {
    font-size: 17px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .contact-card .sub {
    font-size: 13px;
    color: var(--color-ink-2);
    margin-top: 2px;
  }
  .contact-card .arrow {
    color: var(--color-mute);
  }
  .contact-card .arrow svg {
    width: 14px;
    height: 14px;
  }

  .map-frame {
    height: 240px;
    border: 1px solid var(--color-line);
    border-radius: 14px;
    overflow: hidden;
  }
  .map-frame iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
</style>
