---
// Section À propos : présentation avec collage photo,
// statistiques de confiance et grille « Pourquoi me choisir ».
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import portraitPhoto from '../assets/photos/portrait-electricien.jpg';
import domotiquePhoto from '../assets/photos/domotique.jpg';
import { about, company, reasons, testimonials } from '../data/site';
---

<section id="a-propos" class="bg-white py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="grid gap-12 lg:grid-cols-2 lg:items-center lg:gap-16">
      <!-- Collage photo -->
      <div class="relative">
        <div class="overflow-hidden rounded-3xl shadow-xl">
          <Image
            src={portraitPhoto}
            alt="Portrait de Fabien Auffret, électricien indépendant à Châtillon-sur-Loire"
            class="aspect-[4/5] w-full object-cover"
            widths={[400, 700, 1000]}
            sizes="(min-width: 1024px) 45vw, 90vw"
          />
        </div>

        <!-- Photo secondaire superposée -->
        <div
          class="absolute -right-4 -bottom-8 hidden w-44 overflow-hidden rounded-2xl border-4 border-white shadow-lg sm:block lg:w-52"
        >
          <Image
            src={domotiquePhoto}
            alt="Installation d'un thermostat connecté par l'électricien"
            class="aspect-square w-full object-cover"
            widths={[200, 416]}
            sizes="208px"
          />
        </div>

        <!-- Badge note flottant -->
        <div
          class="bg-night-950 absolute -top-5 -left-4 flex items-center gap-2.5 rounded-2xl px-4 py-3 shadow-lg"
        >
          <Icon name="star" class="text-volt-400 h-6 w-6" filled />
          <div class="leading-tight">
            <span class="block text-lg font-extrabold text-white">{company.rating.value}/5</span>
            <span class="text-night-300 block text-xs"
              >{testimonials.reviews.length} avis clients</span
            >
          </div>
        </div>
      </div>

      <!-- Présentation -->
      <div>
        <SectionHeading label={about.label} title={about.title} align="left" />
        <div class="mt-6 flex flex-col gap-4">
          {about.paragraphs.map((text) => <p class="text-night-600 leading-relaxed">{text}</p>)}
        </div>

        <dl class="border-night-100 mt-8 grid grid-cols-3 gap-4 border-t pt-8">
          {
            about.stats.map((stat) => (
              <div>
                <dt class="sr-only">{stat.label}</dt>
                <dd>
                  <span class="text-night-900 block text-2xl font-extrabold sm:text-3xl">
                    {stat.value}
                  </span>
                  <span class="text-night-500 mt-1 block text-xs font-medium">{stat.label}</span>
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>

    <!-- Pourquoi me choisir -->
    <div class="mt-24 sm:mt-28">
      <SectionHeading label={reasons.label} title={reasons.title} />
      <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          reasons.items.map((reason) => (
            <li class="reveal border-night-100 bg-night-50 flex flex-col items-center rounded-2xl border p-6 text-center transition-shadow hover:shadow-md">
              <span class="bg-volt-400/15 text-volt-600 flex h-12 w-12 items-center justify-center rounded-full">
                <Icon name={reason.icon} class="h-6 w-6" />
              </span>
              <h3 class="text-night-900 mt-4 text-base font-bold">{reason.title}</h3>
              <p class="text-night-500 mt-2 text-sm leading-relaxed">{reason.description}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
