---
// Section À propos : fond encre sombre, portrait 4:5 et paragraphes
// avec emphases bleues + carte d'information à 3 indicateurs.
import { Image } from 'astro:assets';
import SectionHeading from './SectionHeading.astro';
import portraitPhoto from '../assets/photos/portrait-electricien.jpg';
import { about } from '../data/site';
---

<section class="section about on-ink" id="a-propos">
  <div class="wrap">
    <SectionHeading
      index={about.index}
      label={about.label}
      title={about.title}
      emphasisLine={about.emphasisLine}
      lead={about.lead}
    />

    <div class="about-grid reveal">
      <div class="about-portrait">
        <Image
          src={portraitPhoto}
          alt="Portrait de Fabien Auffret, électricien indépendant à Châtillon-sur-Loire"
          class="portrait-img"
          widths={[400, 700, 1000]}
          sizes="(min-width: 980px) 42vw, 90vw"
        />
        <span class="corner-mark">[ PORTRAIT · 4:5 ]</span>
        <span class="corner-mark br">N° 01</span>
      </div>

      <div>
        <div class="about-paragraphs">
          {about.paragraphs.map((text) => <p set:html={text} />)}
        </div>
        <div class="info-card">
          {
            about.infoCard.map((item) => (
              <div class="item">
                <div class="l">{item.label}</div>
                <div class="v">
                  <span class="em-blue">{item.value}</span> {item.suffix}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    background: var(--color-ink);
    color: var(--color-on-ink);
  }
  .about-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 56px;
  }
  @media (max-width: 980px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
  }
  .about-portrait {
    aspect-ratio: 4/5;
    background: #060709;
    border-radius: 14px;
    overflow: hidden;
    position: relative;
    border: 1px solid color-mix(in oklab, var(--color-on-ink) 18%, transparent);
  }
  .portrait-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .corner-mark {
    position: absolute;
    top: 18px;
    left: 18px;
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.16em;
    color: color-mix(in oklab, var(--color-electric-hi) 70%, transparent);
    background: color-mix(in oklab, var(--color-ink) 70%, transparent);
    padding: 4px 8px;
    border-radius: 4px;
    backdrop-filter: blur(4px);
  }
  .corner-mark.br {
    top: auto;
    left: auto;
    bottom: 18px;
    right: 18px;
  }

  .about-paragraphs p {
    font-size: 17px;
    line-height: 1.6;
    color: color-mix(in oklab, var(--color-on-ink) 88%, transparent);
    margin: 0 0 18px;
    max-width: 56ch;
  }
  /* `.em` est utilisé via set:html depuis les données. */
  .about-paragraphs :global(.em) {
    color: var(--color-electric-hi);
    font-weight: 500;
  }

  .info-card {
    margin-top: 32px;
    padding: 22px 24px;
    background: color-mix(in oklab, var(--color-ink) 90%, var(--color-on-ink) 10%);
    border: 1px solid color-mix(in oklab, var(--color-on-ink) 18%, transparent);
    border-radius: 12px;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 24px;
  }
  @media (max-width: 640px) {
    .info-card {
      grid-template-columns: 1fr;
    }
  }
  .info-card .item .l {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--color-on-ink) 55%, transparent);
    margin-bottom: 8px;
  }
  .info-card .item .v {
    font-size: 24px;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .info-card .item .v .em-blue {
    color: var(--color-electric-hi);
  }
</style>
