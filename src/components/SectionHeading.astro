---
// En-tête de section réutilisable : étiquette, titre H2 et sous-titre.
interface Props {
  label: string;
  title: string;
  subtitle?: string;
  align?: 'center' | 'left';
  dark?: boolean;
}

const { label, title, subtitle, align = 'center', dark = false } = Astro.props;
const alignClass =
  align === 'center' ? 'mx-auto text-center items-center' : 'text-left items-start';
---

<div class={`flex max-w-2xl flex-col gap-3 ${alignClass}`}>
  <span
    class:list={[
      'inline-flex items-center gap-2 text-sm font-bold tracking-[0.16em] uppercase',
      dark ? 'text-volt-300' : 'text-volt-600',
    ]}
  >
    <span class="h-px w-6 bg-current"></span>
    {label}
  </span>
  <h2
    class:list={[
      'text-3xl font-extrabold tracking-tight sm:text-4xl',
      dark ? 'text-white' : 'text-night-900',
    ]}
  >
    {title}
  </h2>
  {
    subtitle && (
      <p class:list={['text-base leading-relaxed', dark ? 'text-night-300' : 'text-night-500']}>
        {subtitle}
      </p>
    )
  }
</div>
