---
// En-tête sticky : logo + brand-meta, navigation pilule et CTA téléphone.
import { company, navigation } from '../data/site';
---

<header class="topbar">
  <div class="wrap topbar-inner">
    <a href="#accueil" class="brand" aria-label="Retour en haut de page">
      <span class="brand-mark" aria-hidden="true">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.4"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M13 2 4 14h7l-1 8 9-12h-7l1-8Z"></path>
        </svg>
      </span>
      <span class="brand-name">{company.name}</span>
      <span class="brand-meta"
        >{company.role} · {company.address.region} {company.address.regionCode}</span
      >
    </a>

    <nav class="primary" aria-label="Navigation principale">
      {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <a class="top-cta" href={company.phoneLink}>
      <span class="dot" aria-hidden="true"></span>
      {company.phoneDisplay}
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M5 12h14M12 5l7 7-7 7"></path>
      </svg>
    </a>

    <!-- Bouton menu mobile -->
    <button
      type="button"
      class="menu-toggle"
      aria-label="Ouvrir le menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-toggle
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        data-icon-menu
      >
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        data-icon-close
        class="hidden-icon"
      >
        <path d="M6 6 18 18M18 6 6 18"></path>
      </svg>
    </button>
  </div>

  <!-- Menu mobile déroulant -->
  <div id="mobile-menu" class="mobile-menu" data-mobile-menu hidden>
    <div class="wrap">
      {
        navigation.map((item) => (
          <a href={item.href} data-menu-link>
            {item.label}
          </a>
        ))
      }
      <a href={company.phoneLink} class="mobile-cta" data-menu-link>
        <span class="dot" aria-hidden="true"></span>
        {company.phoneDisplay}
      </a>
    </div>
  </div>
</header>

<script>
  // Ouverture / fermeture du menu mobile.
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
  const iconMenu = document.querySelector<SVGElement>('[data-icon-menu]');
  const iconClose = document.querySelector<SVGElement>('[data-icon-close]');

  const setMenu = (open: boolean) => {
    if (!menu) return;
    if (open) menu.removeAttribute('hidden');
    else menu.setAttribute('hidden', '');
    iconMenu?.classList.toggle('hidden-icon', open);
    iconClose?.classList.toggle('hidden-icon', !open);
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
  };

  toggle?.addEventListener('click', () => setMenu(menu?.hasAttribute('hidden') ?? false));
  document
    .querySelectorAll('[data-menu-link]')
    .forEach((link) => link.addEventListener('click', () => setMenu(false)));
</script>

<style>
  /* ── Barre supérieure ───────────────────────────────────── */
  .topbar {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in oklab, var(--color-canvas) 90%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-line);
  }
  .topbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 68px;
    gap: 16px;
  }

  /* ── Marque ─────────────────────────────────────────────── */
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    color: inherit;
    text-decoration: none;
  }
  .brand-mark {
    width: 30px;
    height: 30px;
    background: var(--color-ink);
    color: var(--color-electric-hi);
    border-radius: 8px;
    display: grid;
    place-items: center;
  }
  .brand-mark svg {
    width: 14px;
    height: 14px;
  }
  .brand-name {
    font-weight: 600;
    font-size: 15px;
    letter-spacing: -0.01em;
  }
  .brand-meta {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    color: var(--color-mute);
    border-left: 1px solid var(--color-line);
    padding-left: 12px;
    margin-left: 4px;
  }

  /* ── Navigation pilule ──────────────────────────────────── */
  nav.primary {
    display: flex;
    gap: 0;
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: 999px;
    padding: 4px;
  }
  nav.primary a {
    padding: 7px 14px;
    font-size: 13px;
    color: var(--color-ink-2);
    font-weight: 500;
    border-radius: 999px;
    text-decoration: none;
    transition:
      background 0.2s,
      color 0.2s;
  }
  nav.primary a:hover {
    background: var(--color-stone);
    color: var(--color-ink);
  }

  /* ── CTA téléphone ──────────────────────────────────────── */
  .top-cta {
    background: var(--color-ink);
    color: var(--color-paper);
    padding: 9px 14px 9px 12px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    transition: background 0.2s;
  }
  .top-cta:hover {
    background: var(--color-electric);
  }
  .top-cta .dot {
    width: 6px;
    height: 6px;
    background: var(--color-electric-hi);
    border-radius: 50%;
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--color-electric-hi) 30%, transparent);
  }
  .top-cta svg {
    width: 12px;
    height: 12px;
  }

  /* ── Bouton menu mobile ─────────────────────────────────── */
  .menu-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--color-line);
    background: var(--color-paper);
    border-radius: 999px;
    color: var(--color-ink);
    cursor: pointer;
  }
  .menu-toggle svg {
    width: 18px;
    height: 18px;
  }
  .hidden-icon {
    display: none;
  }

  /* ── Menu mobile déroulant ──────────────────────────────── */
  .mobile-menu {
    border-top: 1px solid var(--color-line);
    background: color-mix(in oklab, var(--color-canvas) 96%, transparent);
    backdrop-filter: blur(10px);
  }
  .mobile-menu .wrap {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-top: 12px;
    padding-bottom: 16px;
  }
  .mobile-menu a {
    padding: 12px 16px;
    font-size: 15px;
    color: var(--color-ink-2);
    text-decoration: none;
    border-radius: 12px;
    transition: background 0.2s;
  }
  .mobile-menu a:hover {
    background: var(--color-paper);
  }
  .mobile-menu .mobile-cta {
    margin-top: 8px;
    background: var(--color-ink);
    color: white;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    justify-content: center;
    font-weight: 500;
  }
  .mobile-menu .mobile-cta .dot {
    width: 6px;
    height: 6px;
    background: var(--color-electric-hi);
    border-radius: 50%;
  }

  @media (max-width: 920px) {
    nav.primary,
    .brand-meta {
      display: none;
    }
    .menu-toggle {
      display: inline-flex;
    }
  }
  @media (max-width: 640px) {
    .top-cta {
      font-size: 12px;
      padding: 8px 12px 8px 10px;
    }
    .top-cta svg {
      display: none;
    }
  }
</style>
