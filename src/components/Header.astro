---
// En-tête sticky : logo de la marque (pastille blanche), navigation
// pilule et CTA téléphone.
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { company, navigation } from '../data/site';
---

<header class="topbar">
  <div class="wrap topbar-inner">
    <a href="/#accueil" class="brand" aria-label={`${company.name} — accueil`}>
      <span class="brand-chip">
        <Image
          src={logo}
          alt={company.fullName}
          class="brand-logo"
          widths={[120, 240]}
          sizes="120px"
          loading="eager"
        />
      </span>
      <span class="brand-meta">{company.metaLine}</span>
    </a>

    <nav class="primary" aria-label="Navigation principale">
      {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <a class="top-cta" href={company.phoneLink}>
      <span class="dot" aria-hidden="true"></span>
      {company.phoneDisplay}
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M5 12h14M12 5l7 7-7 7"></path>
      </svg>
    </a>

    <!-- Bouton menu mobile -->
    <button
      type="button"
      class="menu-toggle"
      aria-label="Ouvrir le menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-toggle
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        data-icon-menu
      >
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        data-icon-close
        class="icon-close"
      >
        <path d="M6 6 18 18M18 6 6 18"></path>
      </svg>
    </button>
  </div>

  <!-- Menu mobile déroulant -->
  <div id="mobile-menu" class="mobile-menu" data-mobile-menu>
    <div class="wrap">
      {
        navigation.map((item) => (
          <a href={item.href} data-menu-link>
            {item.label}
          </a>
        ))
      }
      <a href={company.phoneLink} class="mobile-cta" data-menu-link>
        <span class="dot" aria-hidden="true"></span>
        {company.phoneDisplay}
      </a>
    </div>
  </div>
</header>

<script>
  // Ouverture / fermeture animée du menu mobile (piloté par la classe .is-open).
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');

  const setMenu = (open: boolean) => {
    menu?.classList.toggle('is-open', open);
    toggle?.classList.toggle('is-open', open);
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
  };

  toggle?.addEventListener('click', () => setMenu(!(menu?.classList.contains('is-open') ?? false)));
  document
    .querySelectorAll('[data-menu-link]')
    .forEach((link) => link.addEventListener('click', () => setMenu(false)));

  // Ferme le menu avec la touche Échap.
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setMenu(false);
  });
</script>

<style>
  /* ── Barre supérieure ───────────────────────────────────── */
  .topbar {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in oklab, var(--color-canvas) 90%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-line);
  }
  .topbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
    gap: 16px;
  }

  /* ── Marque (logo en pastille) ──────────────────────────── */
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    color: inherit;
    text-decoration: none;
  }
  .brand-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #ffffff;
    border: 1px solid var(--color-line);
    border-radius: 12px;
    padding: 5px 9px;
    box-shadow: 0 1px 2px rgba(14, 22, 38, 0.05);
  }
  .brand-logo {
    height: 38px;
    width: auto;
    display: block;
  }
  .brand-meta {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-mute);
    border-left: 1px solid var(--color-line);
    padding-left: 12px;
    white-space: nowrap;
  }

  /* ── Navigation pilule ──────────────────────────────────── */
  nav.primary {
    display: flex;
    gap: 0;
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: 999px;
    padding: 4px;
  }
  nav.primary a {
    padding: 7px 14px;
    font-size: 13px;
    color: var(--color-ink-2);
    font-weight: 500;
    border-radius: 999px;
    text-decoration: none;
    transition:
      background 0.2s,
      color 0.2s;
  }
  nav.primary a:hover {
    background: var(--color-stone);
    color: var(--color-ink);
  }

  /* ── CTA téléphone ──────────────────────────────────────── */
  .top-cta {
    background: var(--color-ink);
    color: var(--color-paper);
    padding: 9px 14px 9px 12px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    transition:
      background 0.2s,
      color 0.2s;
  }
  .top-cta:hover {
    background: var(--color-electric);
    color: var(--color-ink);
  }
  .top-cta .dot {
    width: 6px;
    height: 6px;
    background: var(--color-electric-hi);
    border-radius: 50%;
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--color-electric-hi) 30%, transparent);
  }
  .top-cta:hover .dot {
    background: var(--color-ink);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--color-ink) 25%, transparent);
  }
  .top-cta svg {
    width: 12px;
    height: 12px;
  }

  /* ── Bouton menu mobile (icônes empilées + animation) ───── */
  .menu-toggle {
    display: none;
    position: relative;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--color-line);
    background: var(--color-paper);
    border-radius: 999px;
    color: var(--color-ink);
    cursor: pointer;
  }
  .menu-toggle svg {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 18px;
    height: 18px;
    transition:
      opacity 0.25s ease,
      transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  /* État fermé : burger visible, croix masquée (légèrement tournée). */
  .menu-toggle .icon-close {
    opacity: 0;
    transform: rotate(-90deg) scale(0.7);
  }
  /* État ouvert : burger masqué, croix visible. */
  .menu-toggle.is-open [data-icon-menu] {
    opacity: 0;
    transform: rotate(90deg) scale(0.7);
  }
  .menu-toggle.is-open .icon-close {
    opacity: 1;
    transform: rotate(0) scale(1);
  }

  /* ── Menu mobile déroulant (ouverture/fermeture animée) ─── */
  .mobile-menu {
    border-top: 1px solid transparent;
    background: color-mix(in oklab, var(--color-canvas) 96%, transparent);
    backdrop-filter: blur(10px);
    overflow: hidden;
    max-height: 0;
    opacity: 0;
    visibility: hidden;
    transition:
      max-height 0.34s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.26s ease,
      visibility 0.34s,
      border-color 0.34s ease;
  }
  .mobile-menu.is-open {
    max-height: 80vh;
    opacity: 1;
    visibility: visible;
    border-top-color: var(--color-line);
  }
  .mobile-menu .wrap {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-top: 12px;
    padding-bottom: 16px;
  }
  /* Petite entrée en cascade des liens à l'ouverture. */
  .mobile-menu .wrap > * {
    opacity: 0;
    transform: translateY(-6px);
  }
  .mobile-menu.is-open .wrap > * {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.3s ease,
      transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .mobile-menu.is-open .wrap > *:nth-child(1) {
    transition-delay: 0.06s;
  }
  .mobile-menu.is-open .wrap > *:nth-child(2) {
    transition-delay: 0.1s;
  }
  .mobile-menu.is-open .wrap > *:nth-child(3) {
    transition-delay: 0.14s;
  }
  .mobile-menu.is-open .wrap > *:nth-child(4) {
    transition-delay: 0.18s;
  }
  .mobile-menu.is-open .wrap > *:nth-child(5) {
    transition-delay: 0.22s;
  }
  @media (prefers-reduced-motion: reduce) {
    .menu-toggle svg,
    .mobile-menu,
    .mobile-menu .wrap > * {
      transition: none;
    }
  }
  .mobile-menu a {
    padding: 12px 16px;
    font-size: 15px;
    color: var(--color-ink-2);
    text-decoration: none;
    border-radius: 12px;
    transition: background 0.2s;
  }
  .mobile-menu a:hover {
    background: var(--color-paper);
  }
  .mobile-menu .mobile-cta {
    margin-top: 8px;
    background: var(--color-ink);
    color: white;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    justify-content: center;
    font-weight: 500;
  }
  .mobile-menu .mobile-cta .dot {
    width: 6px;
    height: 6px;
    background: var(--color-electric-hi);
    border-radius: 50%;
  }

  /* Masque la ligne « métier » plus tôt pour éviter de tasser la nav. */
  @media (max-width: 1080px) {
    .brand-meta {
      display: none;
    }
  }
  @media (max-width: 920px) {
    nav.primary {
      display: none;
    }
    .menu-toggle {
      display: inline-flex;
    }
  }
  @media (max-width: 640px) {
    .top-cta {
      font-size: 12px;
      padding: 8px 12px 8px 10px;
    }
    .top-cta svg {
      display: none;
    }
  }
</style>
