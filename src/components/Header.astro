---
// En-tête sticky : logo textuel, navigation à ancres et CTA.
// Le menu mobile et l'ombre au défilement utilisent un script minimal.
import Icon from './Icon.astro';
import { company, navigation } from '../data/site';
---

<header id="site-header" class="fixed inset-x-0 top-0 z-50 transition-all duration-300" data-header>
  <nav
    class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6"
    aria-label="Navigation principale"
  >
    <!-- Logo textuel -->
    <a href="#accueil" class="group flex items-center gap-2.5" aria-label="Retour en haut de page">
      <span
        class="bg-volt-400 text-night-950 flex h-10 w-10 items-center justify-center rounded-xl shadow-sm"
      >
        <Icon name="bolt" class="h-6 w-6" />
      </span>
      <span class="flex flex-col leading-none">
        <span class="text-lg font-extrabold tracking-tight text-white">{company.name}</span>
        <span class="text-volt-300 text-xs font-medium tracking-[0.18em] uppercase">
          {company.role}
        </span>
      </span>
    </a>

    <!-- Navigation bureau -->
    <ul class="hidden items-center gap-1 lg:flex">
      {
        navigation.map((item) => (
          <li>
            <a
              href={item.href}
              class="text-night-100 rounded-lg px-3 py-2 text-sm font-medium transition-colors hover:bg-white/10 hover:text-white"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <!-- CTA bureau -->
    <div class="hidden items-center gap-3 lg:flex">
      <a
        href={company.phoneLink}
        class="hover:text-volt-300 flex items-center gap-2 text-sm font-semibold text-white transition-colors"
      >
        <Icon name="phone" class="h-4 w-4" />
        {company.phoneDisplay}
      </a>
      <a
        href="#contact"
        class="bg-volt-400 text-night-950 hover:bg-volt-300 rounded-lg px-4 py-2.5 text-sm font-bold shadow-sm transition-all hover:shadow-md"
      >
        Demander un devis
      </a>
    </div>

    <!-- Bouton menu mobile -->
    <button
      type="button"
      class="flex h-11 w-11 items-center justify-center rounded-lg text-white transition-colors hover:bg-white/10 lg:hidden"
      aria-label="Ouvrir le menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-toggle
    >
      <Icon name="menu" class="h-7 w-7" data-icon-menu />
      <Icon name="close" class="hidden h-7 w-7" data-icon-close />
    </button>
  </nav>

  <!-- Menu mobile déroulant -->
  <div
    id="mobile-menu"
    class="bg-night-950/98 hidden border-t border-white/10 backdrop-blur lg:hidden"
    data-mobile-menu
  >
    <ul class="mx-auto flex max-w-6xl flex-col gap-1 px-4 py-4 sm:px-6">
      {
        navigation.map((item) => (
          <li>
            <a
              href={item.href}
              class="text-night-100 block rounded-lg px-3 py-3 text-base font-medium transition-colors hover:bg-white/10 hover:text-white"
              data-menu-link
            >
              {item.label}
            </a>
          </li>
        ))
      }
      <li class="mt-2 flex flex-col gap-3 border-t border-white/10 pt-4">
        <a
          href={company.phoneLink}
          class="flex items-center justify-center gap-2 rounded-lg border border-white/20 px-4 py-3 text-base font-semibold text-white"
        >
          <Icon name="phone" class="h-5 w-5" />
          {company.phoneDisplay}
        </a>
        <a
          href="#contact"
          class="bg-volt-400 text-night-950 rounded-lg px-4 py-3 text-center text-base font-bold"
          data-menu-link
        >
          Demander un devis
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  // Bascule du menu mobile + ombre du header au défilement.
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
  const iconMenu = document.querySelector<SVGElement>('[data-icon-menu]');
  const iconClose = document.querySelector<SVGElement>('[data-icon-close]');

  const setMenu = (open: boolean) => {
    menu?.classList.toggle('hidden', !open);
    iconMenu?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
  };

  toggle?.addEventListener('click', () => {
    setMenu(menu?.classList.contains('hidden') ?? false);
  });

  // Ferme le menu après un clic sur un lien.
  document
    .querySelectorAll('[data-menu-link]')
    .forEach((link) => link.addEventListener('click', () => setMenu(false)));

  // Applique un fond opaque + ombre une fois le héros dépassé.
  const onScroll = () => {
    header?.classList.toggle('is-scrolled', window.scrollY > 24);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  /* État par défaut : fond translucide sombre pour rester lisible sur le héros. */
  [data-header] {
    background-color: color-mix(in srgb, var(--color-night-950) 80%, transparent);
    backdrop-filter: blur(8px);
  }
  /* État défilé : fond plein + ombre portée. */
  [data-header].is-scrolled {
    background-color: var(--color-night-950);
    box-shadow: 0 8px 30px -12px rgba(0, 0, 0, 0.5);
  }
</style>
