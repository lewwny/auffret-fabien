---
// Section Hero : photo de fond plein écran + voile bleu marine,
// titre H1 optimisé SEO et appels à l'action.
// La photo est optimisée par Astro (AVIF/WebP, responsive).
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import heroPhoto from '../assets/photos/hero-electricien.jpg';
import { company, hero, openingHours } from '../data/site';
---

<section id="accueil" class="relative isolate flex min-h-[88vh] items-center overflow-hidden">
  <!-- Photo de fond (image LCP : chargement prioritaire, non différé) -->
  <Image
    src={heroPhoto}
    alt="Fabien Auffret, électricien, en intervention sur une installation électrique"
    class="absolute inset-0 -z-20 h-full w-full object-cover object-center"
    widths={[768, 1280, 1920]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />

  <!-- Voile dégradé pour la lisibilité du texte -->
  <div
    class="from-night-950 via-night-950/90 to-night-950/45 absolute inset-0 -z-10 bg-gradient-to-r"
    aria-hidden="true"
  >
  </div>
  <div
    class="from-night-950 absolute inset-x-0 bottom-0 -z-10 h-32 bg-gradient-to-t to-transparent"
    aria-hidden="true"
  >
  </div>

  <div class="mx-auto w-full max-w-6xl px-4 pt-28 pb-16 sm:px-6 sm:pt-32">
    <div class="max-w-2xl">
      <p
        class="border-volt-400/30 bg-volt-400/10 text-volt-200 inline-flex items-center gap-2 rounded-full border px-3 py-1.5 text-sm font-semibold backdrop-blur"
      >
        <Icon name="star" class="text-volt-300 h-4 w-4" filled />
        {hero.badge}
      </p>

      <h1
        class="mt-5 text-4xl leading-[1.08] font-extrabold tracking-tight text-white sm:text-5xl lg:text-6xl"
      >
        {hero.title}
      </h1>

      <p class="text-night-100 mt-5 max-w-xl text-lg leading-relaxed">
        {hero.subtitle}
      </p>

      <ul class="mt-7 flex flex-wrap gap-x-6 gap-y-2.5">
        {
          hero.highlights.map((item) => (
            <li class="text-night-100 flex items-center gap-2.5">
              <span class="bg-volt-400 text-night-950 flex h-6 w-6 shrink-0 items-center justify-center rounded-full">
                <Icon name="check" class="h-4 w-4" />
              </span>
              <span class="text-sm font-medium">{item}</span>
            </li>
          ))
        }
      </ul>

      <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a
          href={hero.ctaPrimary.href}
          class="group bg-volt-400 text-night-950 shadow-volt-500/25 hover:bg-volt-300 hover:shadow-volt-500/35 inline-flex items-center justify-center gap-2 rounded-xl px-6 py-3.5 text-base font-bold shadow-lg transition-all hover:shadow-xl"
        >
          {hero.ctaPrimary.label}
          <Icon name="arrow" class="h-5 w-5 transition-transform group-hover:translate-x-1" />
        </a>
        <a
          href={company.phoneLink}
          class="inline-flex items-center justify-center gap-2 rounded-xl border border-white/25 bg-white/5 px-6 py-3.5 text-base font-semibold text-white backdrop-blur transition-colors hover:border-white/45 hover:bg-white/10"
        >
          <Icon name="phone" class="text-volt-300 h-5 w-5" />
          {company.phoneDisplay}
        </a>
      </div>
    </div>
  </div>

  <!-- Bandeau de réassurance en bas du héros -->
  <div class="bg-night-950/85 absolute inset-x-0 bottom-0 border-t border-white/10 backdrop-blur">
    <dl class="mx-auto grid max-w-6xl grid-cols-2 gap-px px-4 sm:px-6 md:grid-cols-4">
      {
        [
          { icon: 'pin', label: 'Zone', value: company.address.locality },
          {
            icon: 'clock',
            label: 'Horaires',
            value: openingHours.display.replace('Lundi – Samedi', 'Lun.–Sam.'),
          },
          { icon: 'shield', label: 'Garantie', value: 'Travail aux normes' },
          { icon: 'star', label: 'Satisfaction', value: `${company.rating.value}/5 sur Google` },
        ].map((item) => (
          <div class="flex items-center gap-3 py-4">
            <span class="bg-volt-400/15 text-volt-300 flex h-9 w-9 shrink-0 items-center justify-center rounded-lg">
              <Icon name={item.icon} class="h-5 w-5" />
            </span>
            <div>
              <dt class="text-night-400 text-[0.7rem] font-medium tracking-wide uppercase">
                {item.label}
              </dt>
              <dd class="text-sm font-semibold text-white">{item.value}</dd>
            </div>
          </div>
        ))
      }
    </dl>
  </div>
</section>
