---
// Section Services : cartes modernes avec icônes minimalistes.
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { services } from '../data/site';
---

<section id="services" class="bg-night-50 py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <SectionHeading label={services.label} title={services.title} subtitle={services.subtitle} />

    <ul class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        services.items.map((service) => (
          <li class="reveal group border-night-100 hover:border-volt-300 hover:shadow-night-900/5 flex flex-col rounded-2xl border bg-white p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl">
            <span class="bg-night-900 text-volt-300 group-hover:bg-volt-400 group-hover:text-night-950 flex h-14 w-14 items-center justify-center rounded-xl transition-colors duration-300">
              <Icon name={service.icon} class="h-7 w-7" />
            </span>
            <h3 class="text-night-900 mt-5 text-lg font-bold">{service.title}</h3>
            <p class="text-night-500 mt-2 text-sm leading-relaxed">{service.description}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
