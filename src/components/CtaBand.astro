---
// Bandeau d'appel à l'action : photo de fond + voile sombre,
// placé entre les sections pour relancer la conversion.
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import cablagePhoto from '../assets/photos/cablage.jpg';
import { company, ctaBand } from '../data/site';
---

<section class="relative isolate overflow-hidden">
  <Image
    src={cablagePhoto}
    alt="Travaux de câblage électrique réalisés par Fabien Auffret"
    class="absolute inset-0 -z-20 h-full w-full object-cover object-center"
    widths={[768, 1280, 1600]}
    sizes="100vw"
    loading="lazy"
  />
  <div class="bg-night-950/85 absolute inset-0 -z-10" aria-hidden="true"></div>

  <div class="mx-auto max-w-4xl px-4 py-20 text-center sm:px-6 sm:py-24">
    <span
      class="text-volt-300 inline-flex items-center gap-2 text-sm font-bold tracking-[0.16em] uppercase"
    >
      <span class="h-px w-6 bg-current"></span>
      {ctaBand.label}
      <span class="h-px w-6 bg-current"></span>
    </span>
    <h2 class="mt-4 text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
      {ctaBand.title}
    </h2>
    <p class="text-night-200 mx-auto mt-4 max-w-xl text-base leading-relaxed">
      {ctaBand.subtitle}
    </p>

    <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row sm:items-center">
      <a
        href="#contact"
        class="group bg-volt-400 text-night-950 shadow-volt-500/25 hover:bg-volt-300 inline-flex items-center justify-center gap-2 rounded-xl px-6 py-3.5 text-base font-bold shadow-lg transition-all hover:shadow-xl"
      >
        Demander un devis gratuit
        <Icon name="arrow" class="h-5 w-5 transition-transform group-hover:translate-x-1" />
      </a>
      <a
        href={company.phoneLink}
        class="inline-flex items-center justify-center gap-2 rounded-xl border border-white/25 bg-white/5 px-6 py-3.5 text-base font-semibold text-white backdrop-blur transition-colors hover:border-white/45 hover:bg-white/10"
      >
        <Icon name="phone" class="text-volt-300 h-5 w-5" />
        {company.phoneDisplay}
      </a>
    </div>
  </div>
</section>
