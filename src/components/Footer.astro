---
// Pied de page : logo + grand titre + CTA, grille 4 colonnes, barre légale.
// Fond encre marine identique à la section À propos.
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { company, navigation, openingHours } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="wrap">
    <div class="foot-top">
      <div>
        <span class="foot-brand">
          <Image
            src={logo}
            alt={company.fullName}
            class="foot-logo"
            widths={[120, 240]}
            sizes="120px"
          />
        </span>
        <h2>
          Un projet à réaliser&nbsp;?<br />
          <span class="em-blue">Parlons-en.</span>
        </h2>
      </div>
      <div class="foot-cta">
        <a class="btn btn-primary" href="#contact">
          Demander un devis
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
          >
            <path d="M5 12h14M12 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>
    </div>

    <div class="foot-grid">
      <div>
        <h4>Adresse</h4>
        <ul>
          <li>{company.address.extended}</li>
          <li>{company.address.street}</li>
          <li>{company.address.postalCode} {company.address.locality}</li>
          <li>{company.address.region} · France</li>
        </ul>
      </div>
      <div>
        <h4>Contact</h4>
        <ul>
          <li><a href={company.phoneLink}>{company.phoneDisplay}</a></li>
          <li><a href={company.emailLink}>{company.email}</a></li>
          <li>Devis sous 24 h</li>
        </ul>
      </div>
      <div>
        <h4>Plan</h4>
        <ul>
          <li><a href="#accueil">Accueil</a></li>
          {
            navigation.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h4>Horaires</h4>
        <ul>
          <li>{openingHours.display}</li>
          <li>{openingHours.closed}</li>
          <li>Rayon de {company.radiusKm} km</li>
        </ul>
      </div>
    </div>

    <div class="foot-bottom">
      <div>© {year} {company.fullName} · SIRET {company.siretDisplay}</div>
      <div>
        <a href="/mentions-legales">Mentions légales</a>
        <span class="sep">·</span>
        <a href="/mentions-legales#donnees">Confidentialité</a>
      </div>
    </div>

    <!-- Bandeau promotionnel : création du site (Leny Garcia) -->
    <a class="foot-credit" href="https://garcialeny.com" target="_blank" rel="noopener noreferrer">
      <span class="foot-credit-spark" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="currentColor">
          <path d="M13 2 4 14h7l-1 8 9-12h-7l1-8Z"></path>
        </svg>
      </span>
      <span class="foot-credit-text">
        <span class="foot-credit-label">Un site web comme celui-ci pour votre activité&nbsp;?</span>
        <span class="foot-credit-name">Création de sites internet — Leny Garcia</span>
      </span>
      <span class="foot-credit-cta">
        garcialeny.com
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        >
          <path d="m7 17 10-10M17 7H8m9 0v9"></path>
        </svg>
      </span>
    </a>
  </div>
</footer>

<style>
  .foot {
    background: var(--color-ink);
    color: color-mix(in oklab, var(--color-on-ink) 70%, transparent);
    padding: 64px 0 28px;
    font-size: 13.5px;
  }
  .foot a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s;
  }
  .foot a:hover {
    color: var(--color-electric-hi);
  }
  .foot-top {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 40px;
    align-items: end;
    padding-bottom: 40px;
    border-bottom: 1px solid color-mix(in oklab, var(--color-on-ink) 18%, transparent);
  }
  @media (max-width: 820px) {
    .foot-top {
      grid-template-columns: 1fr;
    }
  }
  .foot-brand {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #ffffff;
    border-radius: 12px;
    padding: 6px 10px;
    margin-bottom: 22px;
  }
  .foot-logo {
    height: 40px;
    width: auto;
    display: block;
  }
  .foot-top h2 {
    font-size: clamp(34px, 4.6vw, 56px);
    line-height: 1.02;
    letter-spacing: -0.035em;
    color: var(--color-on-ink);
    font-weight: 500;
  }
  .foot-top h2 .em-blue {
    color: var(--color-electric-hi);
  }
  .foot-cta {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }
  @media (max-width: 820px) {
    .foot-cta {
      justify-content: flex-start;
    }
  }

  .foot-grid {
    margin-top: 40px;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1fr;
    gap: 32px;
  }
  @media (max-width: 820px) {
    .foot-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 480px) {
    .foot-grid {
      grid-template-columns: 1fr;
    }
  }
  .foot-grid h4 {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-electric-hi);
    margin: 0 0 16px;
    font-weight: 500;
  }
  .foot-grid ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .foot-bottom {
    margin-top: 40px;
    padding-top: 22px;
    border-top: 1px solid color-mix(in oklab, var(--color-on-ink) 14%, transparent);
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--color-on-ink) 45%, transparent);
  }
  .foot-bottom .sep {
    margin: 0 8px;
    opacity: 0.5;
  }

  /* ── Bandeau promo « création de site » ─────────────────── */
  .foot-credit {
    margin-top: 22px;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 20px;
    border-radius: 14px;
    background: color-mix(in oklab, var(--color-on-ink) 6%, transparent);
    border: 1px solid color-mix(in oklab, var(--color-on-ink) 14%, transparent);
    text-decoration: none;
    color: var(--color-on-ink);
    transition:
      border-color 0.25s,
      background 0.25s;
  }
  .foot-credit:hover {
    border-color: var(--color-electric);
    background: color-mix(in oklab, var(--color-electric) 10%, transparent);
    color: var(--color-on-ink);
  }
  .foot-credit-spark {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    flex-shrink: 0;
    border-radius: 9px;
    background: var(--color-electric);
    color: var(--color-ink);
  }
  .foot-credit-spark svg {
    width: 16px;
    height: 16px;
  }
  .foot-credit-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-right: auto;
  }
  .foot-credit-label {
    font-size: 14px;
    color: var(--color-on-ink);
  }
  .foot-credit-name {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--color-on-ink) 55%, transparent);
  }
  .foot-credit-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
    font-weight: 600;
    font-size: 14px;
    color: var(--color-electric-hi);
  }
  .foot-credit-cta svg {
    width: 14px;
    height: 14px;
    transition: transform 0.2s;
  }
  .foot-credit:hover .foot-credit-cta svg {
    transform: translate(2px, -2px);
  }
  @media (max-width: 540px) {
    .foot-credit {
      flex-wrap: wrap;
    }
    .foot-credit-text {
      margin-right: 0;
    }
  }
</style>
