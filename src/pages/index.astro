---
// Page d'accueil — landing page one-page de Fabien Auffret, électricien.
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import CtaBand from '../components/CtaBand.astro';
import About from '../components/About.astro';
import Testimonials from '../components/Testimonials.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <!-- Lien d'évitement pour l'accessibilité (clavier / lecteurs d'écran) -->
  <a
    href="#accueil"
    class="focus:bg-volt-400 focus:text-night-950 sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:rounded-lg focus:px-4 focus:py-2 focus:font-bold"
  >
    Aller au contenu principal
  </a>

  <Header />

  <main>
    <Hero />
    <Services />
    <CtaBand />
    <About />
    <Testimonials />
    <Contact />
  </main>

  <Footer />
</Layout>

<script>
  // Apparition progressive des éléments `.reveal` au défilement.
  const items = document.querySelectorAll<HTMLElement>('.reveal');

  if (
    !window.matchMedia('(prefers-reduced-motion: reduce)').matches &&
    'IntersectionObserver' in window
  ) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry, index) => {
          if (entry.isIntersecting) {
            // Léger décalage en cascade pour un effet fluide.
            (entry.target as HTMLElement).style.animationDelay = `${(index % 4) * 80}ms`;
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15 }
    );
    items.forEach((item) => observer.observe(item));
  } else {
    items.forEach((item) => item.classList.add('is-visible'));
  }
</script>
