---
// Layout principal : <head> SEO complet, Open Graph, Twitter Card
// et données structurées JSON-LD pour le référencement local.
import '../styles/global.css';
import { company, openingHours, seo, services, serviceArea } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const { title = seo.title, description = seo.description } = Astro.props;

// URL canonique calculée à partir de `site` dans astro.config.mjs.
const canonical = new URL(Astro.url.pathname, Astro.site ?? company.url).href;
const ogImage = new URL(seo.ogImage, Astro.site ?? company.url).href;

// --- Données structurées Schema.org : artisan multi-métier (SEO local) ---
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': ['Electrician', 'Plumber', 'HVACBusiness'],
  '@id': `${company.url}/#business`,
  name: company.fullName,
  url: company.url,
  image: ogImage,
  telephone: company.phoneLink.replace('tel:', ''),
  email: company.email,
  priceRange: '€€',
  vatID: company.siret,
  address: {
    '@type': 'PostalAddress',
    streetAddress: `${company.address.extended}, ${company.address.street}`,
    postalCode: company.address.postalCode,
    addressLocality: company.address.locality,
    addressRegion: company.address.region,
    addressCountry: company.address.country,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: company.geo.latitude,
    longitude: company.geo.longitude,
  },
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: openingHours.schema.days,
    opens: openingHours.schema.opens,
    closes: openingHours.schema.closes,
  },
  // Zone desservie : cercle de 50 km + communes principales.
  areaServed: [
    {
      '@type': 'GeoCircle',
      geoMidpoint: {
        '@type': 'GeoCoordinates',
        latitude: company.geo.latitude,
        longitude: company.geo.longitude,
      },
      geoRadius: company.radiusKm * 1000,
    },
    ...[serviceArea.primary, ...serviceArea.towns].map((name) => ({
      '@type': 'City',
      name,
    })),
  ],
  makesOffer: services.items.map((s) => ({
    '@type': 'Offer',
    itemOffered: { '@type': 'Service', name: s.title, description: s.description },
  })),
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: company.rating.value,
    reviewCount: company.rating.count,
    bestRating: '5',
  },
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Polices Google Fonts (preconnect pour réduire la latence) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- SEO de base -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content={company.fullName} />
    <meta name="theme-color" content="#0E1626" />
    <meta name="geo.region" content="FR-45" />
    <meta name="geo.placename" content={company.address.locality} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={seo.locale} />
    <meta property="og:site_name" content={company.fullName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${company.fullName} — ${company.address.locality}`} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Données structurées JSON-LD (SEO local) -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>
  <body>
    <slot />
  </body>
</html>
